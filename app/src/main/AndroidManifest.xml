<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Detail #4: since API 28, ACTION_DELETE without this permission is
         silently refused by the installer — "Uninstall" opens nothing.
         It's a normal permission: granted at install time, no user prompt. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- For the wallpaper option in settings. Normal permission, no dialog. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Detail #2: since API 30 Android hides installed apps.
         Without this block the drawer comes back EMPTY with no error at all. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nim">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <!-- Detail #1: this is what makes the app be offered as HOME. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Detail #3: with nothing handling CONFIRM_PIN_SHORTCUT,
             isRequestPinShortcutSupported() returns false and Chrome hides
             "Install app"/"Add to home screen" for PWAs. Exported because the
             system is what starts it; it confirms with the user before accepting. -->
        <activity
            android:name=".PinShortcutActivity"
            android:theme="@style/Theme.Nim.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
