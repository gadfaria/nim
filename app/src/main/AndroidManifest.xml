<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Detalhe nº 4: desde a API 28, ACTION_DELETE sem esta permissão é
         recusado em silêncio pelo instalador — o "Desinstalar" não abre nada.
         É permissão normal: concedida na instalação, sem pedir ao usuário. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Para a opção de papel de parede nas configurações. Permissão normal,
         sem diálogo. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Detalhe nº 2: a partir da API 30 o Android esconde os apps instalados.
         Sem este bloco a gaveta vem VAZIA e sem erro nenhum. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nim">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <!-- Detalhe nº 1: é isto que faz o app ser oferecido como HOME. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Detalhe nº 3: sem quem atenda CONFIRM_PIN_SHORTCUT, o
             isRequestPinShortcutSupported() dá false e o Chrome esconde
             "Instalar app"/"Adicionar à tela inicial" para os PWAs. -->
        <activity
            android:name=".PinShortcutActivity"
            android:theme="@style/Theme.Nim.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
